 "lines": [
  {
   "at": 0.4,
   "until": 5,
   "text": "Still building your staff roster in a spreadsheet?"
  },
  {
   "at": 5.35,
   "until": 17,
   "text": "Here's a normal week. Every swap request comes to you, by text, by email, by phone. By Thursday, a shift slips through, and the roster has cost you about four hours."
  },
  {
   "at": 17.35,
   "until": 22.2,
   "text": "Tidewell works in three steps. Publish the roster, and everyone sees their shifts on their phone."
  },
  {
   "at": null,
   "until": 26.2,
   "text": "When Ben can't make Thursday, he offers the shift, and Dana, in the same role, picks it up."
  },
  {
   "at": null,
   "until": 33,
   "text": "You see who's covering, and approve it in one tap."
  },
  {
   "at": 33.35,
   "until": 43,
   "text": "Managers go from about four hours on the roster to about thirty minutes. And gaps show up days ahead, not on the morning of the shift."
  },
  {
   "at": 43.35,
   "until": 49.5,
   "text": "It's built for teams of ten to sixty who work in shifts. Clinics, cafés, gyms and shops."
  },
  {
   "at": 49.85,
   "until": 56,
   "text": "Try Tidewell free for thirty days, or book a fifteen-minute walkthrough."
  }
 ],
